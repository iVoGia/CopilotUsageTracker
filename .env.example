# Copilot Usage Tracker — environment template
# Copy to .env and adjust secrets before production use.

DATABASE_URL=postgresql://ghc:ghc@localhost:5432/ghc?schema=public
REDIS_URL=redis://localhost:6379
JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_DAYS=30
PORT=3001

# Optional GitHub OAuth (dashboard). Without these, use POST /api/auth/dev-login.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_WS_URL=http://localhost:3001

SESSION_WORKER_INTERVAL_MS=60000
